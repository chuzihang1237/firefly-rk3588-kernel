#ifdef FF_USB30 // Type-C1 to Type-A
&combphy2_psu {
	status = "okay";
};

&usbhost3_0 {
	status = "okay";
};

&usbhost_dwc3_0 {
	status = "okay";
	dr_mode = "host";
};

//&u2phy3_host {
//        status = "okay";
//};

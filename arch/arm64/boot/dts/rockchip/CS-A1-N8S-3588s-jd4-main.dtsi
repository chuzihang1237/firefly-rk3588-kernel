/dts-v1/;


#include <dt-bindings/leds/common.h>
#include "rk3588-firefly-common.dtsi"

/ {
#ifdef FF_TYPEC0
	vbus5v0_typec0: vbus5v0-typec0 {
		compatible = "regulator-fixed";
		regulator-name = "vbus5v0_typec0";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		enable-active-high;
		gpios = <&gpio4 RK_PA7 GPIO_ACTIVE_LOW>;   ///GPIO4_A7
		pinctrl-names = "default";
		pinctrl-0 = <&vbus5v0_typec0_en>;
		vin-supply = <&vcc5v0_usb>;
	};
#endif

#ifdef FF_USB20_HOST0
	vcc5v0_host: vcc5v0-host {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_host";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		regulator-boot-on;
		regulator-always-on;
		enable-active-high;
		gpio = <&gpio4 RK_PB5 GPIO_ACTIVE_HIGH>;		//GPIO4_B5_d
		vin-supply = <&vcc5v0_usb>;
	};
#endif

#ifdef FF_FAN
	vcc_fan_ctl: vcc-fan-ctl-regulator {
			compatible = "regulator-fixed";
			regulator-name = "vcc_fan_ctl";
			regulator-always-on;
			enable-active-high;
			status = "okay";
			gpio = <&gpio3 RK_PC4 GPIO_ACTIVE_HIGH>;
	};
#endif


#ifdef FF_SDCARD
	vcc3v3_sd: vcc3v3-sd {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3_sd";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		enable-active-high;
		gpio = <&gpio3 RK_PC6 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&vcc3v3_sd_en>;
		vin-supply = <&vcc_3v3_s3>;
		regulator-state-mem {
			regulator-off-in-suspend;
		};
	};
#endif

	firefly_wake {
		compatible = "firefly-wake";
		status = "okay";
	};

	ds18b20_1 {
		compatible = "firefly,ds1820";
		status = "okay";
		ds1820-dq = <&gpio4 RK_PA6 GPIO_ACTIVE_LOW>; //GPIO4_A6 TEMP_DET_1
		ds18b20-id = <1>;
		pinctrl-names = "default";
		pinctrl-0 = <&ds18b20_dp_1_pin>;
	};

	ds18b20_2 {
		compatible = "firefly,ds1820";
		ds1820-dq = <&gpio4 RK_PA5 GPIO_ACTIVE_LOW>; //GPIO4_A5 TEMP_DET_2
		ds18b20-id = <2>;
		status = "okay";
		pinctrl-names = "default";
		pinctrl-0 = <&ds18b20_dp_2_pin>;
	};

#ifdef FF_LEDS
	firefly_leds: firefly-leds {
		status = "okay";
		compatible = "gpio-leds";
		pinctrl-names = "default";
		pinctrl-0 = <&led_pins>;

		power_led: power-led {
			label = ":power"; // blue
			default-state = "on";
			gpios = <&gpio0 RK_PC4 GPIO_ACTIVE_HIGH>;
		};
		/delete-node/ user;
		HUB30_PWR_EN {
			//BMC LED
			label = "HUB30_PWR_EN";
			gpios = <&gpio0 RK_PD5 GPIO_ACTIVE_HIGH>;	//GPIO0_D5
			default-state = "on";
			retain-state-shutdown;
		};

		HUB30_PWR_RESET {
			label = "HUB30_PWR_RESET";
			gpios = <&gpio1 RK_PC2 GPIO_ACTIVE_HIGH>;   //GPIO1_C2
			default-state = "off";
			retain-state-shutdown;
		};

		NETWORK_SW_PWR_EN {
			label = "NETWORK_SW_PWR_EN";
			gpios = <&gpio3 RK_PD2 GPIO_ACTIVE_LOW>;   //GPIO3_D2
			default-state = "on";
			retain-state-shutdown;
		};

		NETWORK_SW_PWR_RST {
			label = "NETWORK_SW_PWR_RST";
			gpios = <&gpio3 RK_PD4 GPIO_ACTIVE_HIGH>;   //GPIO3_D2
			default-state = "off";
			retain-state-shutdown;
		};

		NETWORK_INTERNAL_PWR_EN {
			label = "NETWORK_INTERNAL_PWR_EN";
			gpios = <&gpio3 RK_PC1 GPIO_ACTIVE_LOW>;   // GPIO3_C1
			default-state = "on";
		};

		// SW_9310_RESET_H {
		// 	label = "SW_9310_RESET_H";
		// 	gpios = <&gpio0 RK_PC0 GPIO_ACTIVE_HIGH>;   //GPIO0_C0
		// 	default-state = "off";
		// };


		//子板的reset脚，写0会reset子板
		PWR_EN_SUB5 {
			label = "PWR_EN_SUB5";
			gpios = <&sub_core_pca9555 PCA_IO0_0 GPIO_ACTIVE_HIGH>;	///GPIO4_B3
			default-state = "on";
			retain-state-shutdown;
		};

		PWR_EN_SUB2 {
			label = "PWR_EN_SUB2";
			gpios = <&sub_core_pca9555 PCA_IO0_1 GPIO_ACTIVE_HIGH>;	//GPIO4_B2
			default-state = "on";
			retain-state-shutdown;
		};

		PWR_EN_SUB3 {
			label = "PWR_EN_SUB3";
			gpios = <&sub_core_pca9555 PCA_IO0_2 GPIO_ACTIVE_HIGH>;	//GPIO4_D1
			default-state = "on";
			retain-state-shutdown;
		};

		PWR_EN_SUB4 {
			label = "PWR_EN_SUB4";
			gpios = <&sub_core_pca9555 PCA_IO0_3 GPIO_ACTIVE_HIGH>;	//GPIO4_D3
			default-state = "on";
			retain-state-shutdown;
		};

		PWR_EN_SUB1 {
			label = "PWR_EN_SUB1";
			gpios = <&sub_core_pca9555 PCA_IO0_4 GPIO_ACTIVE_HIGH>;	//GPIO4_D4
			default-state = "on";
			retain-state-shutdown;
		};

		PWR_EN_SUB6 {
			label = "PWR_EN_SUB6";
			gpios = <&sub_core_pca9555 PCA_IO0_5 GPIO_ACTIVE_HIGH>;	//GPIO4_D2
			default-state = "on";
			retain-state-shutdown;
		};

		PWR_EN_SUB7 {
			label = "PWR_EN_SUB7";
			gpios = <&sub_core_pca9555 PCA_IO0_6 GPIO_ACTIVE_HIGH>;	//GPIO4_B4
			default-state = "on";
			retain-state-shutdown;
		};

		PWR_EN_SUB8 {
			label = "PWR_EN_SUB8";
			gpios = <&sub_core_pca9555 PCA_IO0_7 GPIO_ACTIVE_HIGH>;	//GPIO4_D0
			default-state = "on";
			retain-state-shutdown;
		};

		////////////////////////RESET////////////////////////////

		RESET_SUB1 {
			label = "RESET_SUB1";
			gpios = <&sub_core_pca9555 PCA_IO1_0 GPIO_ACTIVE_HIGH>;	//GPIO1_C2
			default-state = "off";
			retain-state-shutdown;
		};

		RESET_SUB2 {
			label = "RESET_SUB2";
			gpios = <&sub_core_pca9555 PCA_IO1_1 GPIO_ACTIVE_HIGH>;	//GPIO1_C5
			default-state = "off";
			retain-state-shutdown;
		};

		RESET_SUB3 {
			label = "RESET_SUB3";
			gpios = <&sub_core_pca9555 PCA_IO1_2 GPIO_ACTIVE_HIGH>;	//GPIO1_C7
			default-state = "off";
			retain-state-shutdown;
		};

		RESET_SUB4 {
			label = "RESET_SUB4";
			gpios = <&sub_core_pca9555 PCA_IO1_3 GPIO_ACTIVE_HIGH>;	//GPIO1_D4
			default-state = "off";
			retain-state-shutdown;
		};

		RESET_SUB5 {
			label = "RESET_SUB5";
			gpios = <&sub_core_pca9555 PCA_IO1_4 GPIO_ACTIVE_HIGH>;	//GPIO1_C3
			default-state = "off";
			retain-state-shutdown;
		};

		RESET_SUB6 {
			label = "RESET_SUB6";
			gpios = <&sub_core_pca9555 PCA_IO1_5 GPIO_ACTIVE_HIGH>;	//GPIO1_D2
			default-state = "off";
			retain-state-shutdown;
		};

		RESET_SUB7 {
			label = "RESET_SUB7";
			gpios = <&sub_core_pca9555 PCA_IO1_6 GPIO_ACTIVE_HIGH>;	///GPIO1_D5
			default-state = "off";
			retain-state-shutdown;
		};

		RESET_SUB8 {
			label = "RESET_SUB8";
			gpios = <&sub_core_pca9555 PCA_IO1_7 GPIO_ACTIVE_HIGH>;	//GPIO1_C4
			default-state = "off";
			retain-state-shutdown;
		};

		BUZZER {
			//BMC LED
			label = "BUZZER";
			gpios = <&gpio1 RK_PC5 GPIO_ACTIVE_HIGH>;	//GPIO1_C5
			default-state = "off";
			pinctrl-names = "default";
			pinctrl-0 = <&buzzer_ctl>;
		};

		PWR_EN_4G {
			//BMC LED
			label = "PWR_EN_4G";
			gpios = <&gpio1 RK_PB1 GPIO_ACTIVE_HIGH>;	//GPIO1_B1
			default-state = "on";
		};

	};
#endif


#include <dt-bindings/leds/common.h>
#include "rk3588-firefly-common.dtsi"


/ {
#ifdef FF_PCIE
    pcie30_clk_pwr: pcie30-clk-pwr {
        status = "okay";
        compatible = "regulator-fixed";
        regulator-name = "PCIE_PWREN_H";
        regulator-min-microvolt = <1800000>;
        regulator-max-microvolt = <1800000>;
        enable-active-high;
        gpios = <&gpio4 RK_PC6 GPIO_ACTIVE_HIGH>;
        startup-delay-us = <5000>;
        vin-supply = <&vcc12v_dcin>;
    };

    pcie30_clk_oe: pcie30-clk-oe {
        compatible = "regulator-fixed";
        regulator-name = "PCIE30X4_CLKREQn_M1";
        enable-active-low;
        gpios = <&gpio4 RK_PB4 GPIO_ACTIVE_HIGH>;
        regulator-min-microvolt = <3300000>;
        regulator-max-microvolt = <3300000>;
        vin-supply = <&pcie30_clk_pwr>;
    };
#endif

#ifdef FF_MY18B20Z
    my18b20z_1 {
        compatible = "firefly,ds1820";
        status = "okay";
        ds1820-dq = <&gpio3 RK_PB0 GPIO_ACTIVE_LOW>; //GPIO3_B0 TEMP_DET_1
        ds18b20-id = <1>;
        pinctrl-names = "default";
        pinctrl-0 = <&my18b20z_det_1_pin>;
    };

    my18b20z_2 {
        compatible = "firefly,ds1820";
        ds1820-dq = <&gpio3 RK_PA5 GPIO_ACTIVE_LOW>; //GPIO3_A5 TEMP_DET_2
        ds18b20-id = <2>;
        status = "okay";
        pinctrl-names = "default";
        pinctrl-0 = <&my18b20z_det_2_pin>;
    };

    my18b20z_3 {
        compatible = "firefly,ds1820";
        ds1820-dq = <&gpio3 RK_PB3 GPIO_ACTIVE_LOW>; //GPIO3_B3 TEMP_DET_3
        ds18b20-id = <3>;
        status = "okay";
        pinctrl-names = "default";
        pinctrl-0 = <&my18b20z_det_3_pin>;
    };
#endif

#ifdef FF_FAN
    fan: pwm-fan {
		compatible = "pwm-fan";
		#cooling-cells = <2>;
		fan-supply = <&vcc12v_dcin>;
		pwms = <&pwm8 0 50000 1>;
	};
#endif
};

&fiq_debugger{
    rockchip,baudrate = <115200>;  /* Only 115200 and 1500000 */
};

#ifdef FF_GMAC0
&gmac0 {
    status = "okay";
    snps,reset-gpio = <&gpio4 RK_PA7 GPIO_ACTIVE_LOW>;
    tx_delay = <0x31>;
};

&gmac0_tx_bus2{
    rockchip,pins =
    /* gmac0_txd0 */
    <2 RK_PB6 1 &pcfg_pull_up_drv_level_6>,
    /* gmac0_txd1 */
    <2 RK_PB7 1 &pcfg_pull_up_drv_level_6>,
    /* gmac0_txen */
    <2 RK_PC0 1 &pcfg_pull_none>;
};

&gmac0_rgmii_bus{
    rockchip,pins =
    /* gmac0_rxd2 */
    <2 RK_PA6 1 &pcfg_pull_none>,
    /* gmac0_rxd3 */
    <2 RK_PA7 1 &pcfg_pull_none>,
    /* gmac0_txd2 */
    <2 RK_PB1 1 &pcfg_pull_up_drv_level_6>,
    /* gmac0_txd3 */
    <2 RK_PB2 1 &pcfg_pull_up_drv_level_6>;
};
#endif

#ifdef FF_PCIE
&pcie3x4 {
	num-lanes = <1>;
	reset-gpios = <&gpio4 RK_PB6 GPIO_ACTIVE_HIGH>;
	vpcie3v3-supply = <&pcie30_clk_oe>;
	rockchip,perst-inactive-ms = <1000>;
	status = "okay";
};

&pcie30phy {
    rockchip,pcie30-phymode = <PHY_MODE_PCIE_NABIBI>;
	status = "okay";
};
#endif

#ifdef FF_USB
// USB30_TYPEC0
&usbdrd3_0 {
    status = "okay";
};

&usbdrd_dwc3_0 {
    dr_mode = "host";
    phys = <&u2phy0_otg>, <&usbdp_phy0_u3>;
    status = "okay";
};

&u2phy0 {
    status = "okay";
};

&u2phy0_otg {
    status = "okay";
};

&usbdp_phy0 {
    status = "okay";
};

&usbdp_phy0_u3 {
    status = "okay";
};

// USB30_TYPEC1
&usbdrd3_1 {
    status = "okay";
};

&usbdrd_dwc3_1 {
    status = "okay";
    phys = <&u2phy1_otg>, <&usbdp_phy1_u3>;
};

&u2phy1 {
    status = "okay";
};

&u2phy1_otg {
    status = "okay";
};

&usbdp_phy1 {
    status = "okay";
};

&usbdp_phy1_u3 {
    status = "okay";
};

// USB20_HOST0
&usb_host0_ehci {
    status = "okay";
};

&usb_host0_ohci {
    status = "okay";
};

&u2phy2 {
    status = "okay";
};

&u2phy2_host {
    status = "okay";
};

// FF_USB20_HOST1
&usb_host1_ehci {
    status = "okay";
};

&usb_host1_ohci {
    status = "okay";
};

&u2phy3 {
    status = "okay";
};

&u2phy3_host {
    status = "okay";
};
#endif

&i2c3 {
    status = "okay";
    pinctrl-names = "default";
    pinctrl-0 = <&i2c3m4_xfer>;

#ifdef FF_XL9555_CB1
    XL9555_CB1: gpio@24 {
        status = "okay";
        compatible = "nxp,pca9555";
        reg = <0x24>;
        gpio-controller;
        #gpio-cells = <2>;
        gpio-group-num = <300>;
    };
#endif

#if defined(FF_XL9555_CB1) && defined(FF_XL9555_CB1_SUB1)
    XL9555_CB1_SUB1: gpio@20 {
        status = "okay";
        compatible = "nxp,pca9555";
        reg = <0x20>;
        gpio-controller;
        #gpio-cells = <2>;
        gpio-group-num = <320>;
    };
#endif

#if defined(FF_XL9555_CB1) && defined(FF_XL9555_CB1_SUB2)
    XL9555_CB1_SUB2: gpio@21 {
        status = "okay";
        compatible = "nxp,pca9555";
        reg = <0x21>;
        gpio-controller;
        #gpio-cells = <2>;
        gpio-group-num = <340>;
    };
#endif

#if defined(FF_XL9555_CB1) && defined(FF_XL9555_CB1_SUB3)
    XL9555_CB1_SUB3: gpio@22 {
        status = "okay";
        compatible = "nxp,pca9555";
        reg = <0x22>;
        gpio-controller;
        #gpio-cells = <2>;
        gpio-group-num = <360>;
    };
#endif

#if defined(FF_XL9555_CB1) && defined(FF_XL9555_CB1_SUB4)
    XL9555_CB1_SUB4: gpio@23 {
        status = "okay";
        compatible = "nxp,pca9555";

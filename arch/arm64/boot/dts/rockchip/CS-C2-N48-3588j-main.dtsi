#ifdef FF_HDMI1
&hdmi1 {
    enable-gpios = <&gpio4 RK_PA0 GPIO_ACTIVE_HIGH>;  //HDMI1_TX_ON_H
    status = "okay";
};

&hdmi1_in_vp0 {
    status = "okay";
};

&hdmi1_in_vp1 {
    status = "disabled";
};

&i2s6_8ch {
    status = "okay";
};

&hdptxphy_hdmi1 {
    status = "okay";
};

&route_hdmi1{
    status = "okay";
    connect = <&vp0_out_hdmi1>;
};
#endif

#ifdef FF_MCU
&uart9 {
	status = "okay";
	pinctrl-0 = <&uart9m2_xfer>;
};
#endif

#ifdef FF_FAN
&pwm8 {
	pinctrl-0 = <&pwm8m0_pins>;
	status = "okay";
};
#endif

#ifdef FF_POWER
&i2c2 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&i2c2m0_xfer>;
};
#endif

#ifdef FF_WATCHDOG
&i2c1 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&i2c1m2_xfer>;
	pc9202: pc9202@3c {
		status = "okay";
		compatible = "firefly,pc9202";
		reg = <0x3c>;
		wd-en-gpio = <&gpio0 RK_PA0 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&wdt_ctl1>;
		driver-names = "wdtdiban";
	};
};
#endif

#ifdef FF_SPI_FLASH
&spi4 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&spi4m1_cs0 &spi4m1_pins>;

	spi_dev@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <45000000>;
		spi-msb-first;
	};
};
#endif

#ifdef FF_RTC
&i2c1 {
    status = "okay";
    pinctrl-names = "default";
    pinctrl-0 = <&i2c1m2_xfer>;

    pcf8563: pcf8563@51 {
        status = "okay";
        compatible = "nxp,pcf8563";
        reg = <0x51>;
        #clock-cells = <0>;
        clock-frequency = <32768>;
        clock-output-names = "pcf8563-clkout";
        pinctrl-names = "default";
        pinctrl-0 = <&pcf8563_int>;
        interrupt-parent = <&gpio0>;
        interrupts = <RK_PB2 IRQ_TYPE_LEVEL_LOW>;
        // wakeup-source;
    };
};
#endif

#ifdef FF_SUB_DEBUG_UART
&uart0 {
	status = "okay";
	pinctrl-0 = <&uart0m2_xfer>;
};

&uart1 {
	status = "okay";
	pinctrl-0 = <&uart1m1_xfer>;
};

&uart3 {
	status = "okay";
	pinctrl-0 = <&uart3m1_xfer>;
};

&uart4 {
	status = "okay";
	pinctrl-0 = <&uart4m2_xfer>;
};

&uart5 {
	status = "okay";
	pinctrl-0 = <&uart5m0_xfer>;
};

&uart6 {
	status = "okay";
	pinctrl-0 = <&uart6m1_xfer>;
};

&uart7 {
	status = "okay";
	pinctrl-0 = <&uart7m2_xfer>;
};

&uart8 {
	status = "okay";
	pinctrl-0 = <&uart8m0_xfer>;
};
#endif

/* pinctrl */
&pinctrl {
#ifdef FF_MY18B20Z
	my18b20z {
		my18b20z_det_1_pin: my18b20z-det-1-pin {
			rockchip,pins = <3 RK_PB0 RK_FUNC_GPIO &pcfg_pull_none>;  //GPIO3_B0
		};

		my18b20z_det_2_pin: my18b20z-det-2-pin {
			rockchip,pins = <3 RK_PA5 RK_FUNC_GPIO &pcfg_pull_none>;  //GPIO3_A5
		};

        my18b20z_det_3_pin: my18b20z-det-3-pin {
			rockchip,pins = <3 RK_PB3 RK_FUNC_GPIO &pcfg_pull_none>;  //GPIO3_B3
		};
	};
#endif

#ifdef FF_WATCHDOG
	watchdog {
		wdt_ctl1: wdt-ctl {
				rockchip,pins =
				<0 RK_PA0 RK_FUNC_GPIO &pcfg_pull_none>;            //GPIO1_C4
		};
	};
#endif

#ifdef FF_RTC
    pcf8563 {
        pcf8563_int: pcf8563-int {
            rockchip,pins = <0 RK_PB2 RK_FUNC_GPIO &pcfg_pull_up>;
        };
    };
#endif
};
#ifdef FF_WK2XXX
&spi0 {
	status = "okay";
	max-freq = <48000000>;
	pinctrl-names = "default";
	pinctrl-0 = <&spi0m3_cs0 &spi0m3_cs1 &spi0m3_pins>;

	spi_wk2xxx_1: spi_wk2xxx_1@0{
		status = "okay";
		compatible = "wkmic,wk2xxx_spi";
		reg = <0x00>;
		index_base = <1>; // 偏移1，即从ttysWK1开始递增，而非ttysWK0
		num-ports = <4>;  // 4个串口模式
		spi-max-frequency = <10000000>;
		irq-gpio = <&gpio4 RK_PB1 IRQ_TYPE_EDGE_FALLING>;       // WK2124_INT   GPIO4_B1
		cs-gpio = <&gpio3 RK_PD4 GPIO_ACTIVE_HIGH>;
		firefly,spi0;
	};

	spi_wk2xxx_2: spi_wk2xxx_2@1{
		status = "okay";
		compatible = "wkmic,wk2xxx_spi";
		reg = <0x01>;
		index_base = <5>; // 偏移1，即从ttysWK1开始递增，而非ttysWK0
		num-ports = <4>;  // 4个串口模式
		spi-max-frequency = <10000000>;
#ifdef FF_HW_VERSION_V10
		irq-gpio = <&gpio4 RK_PB4 IRQ_TYPE_EDGE_FALLING>;       // WK2124_INT   GPIO4_B4
#endif
#ifdef FF_HW_VERSION_V11
		irq-gpio = <&gpio3 RK_PC7 IRQ_TYPE_EDGE_FALLING>;       // WK2124_INT   GPIO3_C7
#endif
		cs-gpio = <&gpio3 RK_PD5 GPIO_ACTIVE_HIGH>;
		firefly,spi0;
	};
};
#endif

#ifdef FF_SPI_FLASH
// spi flash
&spi1 {
	status = "okay";
	// max-freq = <48000000>;
	pinctrl-names = "default";
	pinctrl-0 = <&spi1m2_cs0 &spi1m2_pins>;

	spi_dev@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <45000000>;
		spi-msb-first;
		// spi-cpol;
		// spi-cpha;
	};
};
#endif

/* pinctrl */
&pinctrl {
#ifdef FF_WATCHDOG
	watchdog {
		wdt_ctl1: wdt-ctl {
				rockchip,pins =
				<1 RK_PC4 RK_FUNC_GPIO &pcfg_pull_none>;            //GPIO1_C4
		};
	};
#endif

#ifdef FF_OTHER
	headphone {
		hp_det: hp-det {
			rockchip,pins = <2 RK_PC3 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
#endif

#ifdef FF_SATA
	sata {
		sata_reset:sata-reset{
			rockchip,pins = <4 RK_PC1 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
#endif

#ifdef FF_DS18B20
	ds18b20-dp-1 {
		ds18b20_dp_1_pin: ds18b20-dp-1-pin {
			rockchip,pins = <4 RK_PB2 RK_FUNC_GPIO &pcfg_pull_none>;  //GPIO4_B2
		};
	};

	ds18b20-dp-2 {
		ds18b20_dp_2_pin: ds18b20-dp-2-pin {
			rockchip,pins = <3 RK_PC7 RK_FUNC_GPIO &pcfg_pull_none>;  //GPIO4_B3
		};
	};
#endif

#ifdef FF_LEDS
    leds {
		BMC_WORK_LED_B_GPIO: BMC-WORK-LED-B-GPIO {
			/* led_power */
			rockchip,pins = <1 RK_PC2 RK_FUNC_GPIO &pcfg_pull_up>;
		};
 	};
#endif

#ifdef FF_WK2XXX
	wk2xxx-irq-gpios {
		wk2xxx_1_irq_gpios: wk2xxx-1-irq-gpios{
			rockchip,pins = <3 RK_PD4 RK_FUNC_GPIO &pcfg_pull_none>; // GPIO3_D4
		};

		// wk2xxx_2_irq_gpios: wk2xxx-2-irq-gpios{
		// 	rockchip,pins = <3 RK_PD5 RK_FUNC_GPIO &pcfg_pull_none>; // GPIO3_D5
		// };
	};
#endif

#ifdef FF_RTC
	hym8563 {
		hym8563_int: hym8563-int {
			rockchip,pins = <0 8 0 &pcfg_pull_none>;
		};
	};
#endif
};

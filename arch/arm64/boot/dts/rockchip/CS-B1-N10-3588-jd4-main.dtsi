#ifdef FF_COOL
&pwm5 {
	pinctrl-0 = <&pwm5m1_pins>;
	status = "okay";
};

// fan
&pwm13 {
	pinctrl-0 = <&pwm13m0_pins>;
	status = "okay";
};
&thermal_zones {
	switch_thermal: switch-thermal {
		polling-delay = <1000>; /* milliseconds */
		polling-delay-passive = <1000>; /* milliseconds */
		thermal-sensors = <&switch_sensor>;

		trips {
			therm_est_trip: therm_est_trip {
				temperature = <85000>;
				type = "passive";
				hysteresis = <1000>;
			};
		};

		cooling-maps {
			map0 {
				trip = <&therm_est_trip>;
				cooling-device = <&dummy_cool_dev THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				contribution = <100>;
			};

		};
	};
};
#endif

#ifdef FF_SDCARD
/* tf-card */
&sdmmc {
	status = "okay";
};
#endif

#ifdef FF_RTC
&i2c0 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&i2c0m2_xfer>;
	// clock-frequency = <400000>;

	hym8563: hym8563@51 {
		status = "okay";
		compatible = "haoyu,hym8563";
		reg = <0x51>;
		#clock-cells = <0>;
		clock-frequency = <32768>;
		clock-output-names = "hym8563";
		pinctrl-names = "default";
		pinctrl-0 = <&hym8563_int>;
		interrupt-parent = <&gpio0>;
		interrupts = <8 8>;
		wakeup-source;
	};
};
#endif

#ifdef FF_PCA953X
&i2c3 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&i2c3m2_xfer>;
	// clock-frequency = <400000>;

	/* XL9555*/
	xl9555_1: gpio@20 {
		status = "okay";
		compatible = "nxp,pca9555";
		reg = <0x20>;
		gpio-controller;
		#gpio-cells = <2>;
		gpio-group-num = <200>;
	};

	xl9555_2: gpio@22 {
		status = "okay";
		compatible = "nxp,pca9555";
		reg = <0x22>;
		gpio-controller;
		#gpio-cells = <2>;
		gpio-group-num = <300>;
	};
};
#endif

#ifdef FF_WATCHDOG
&i2c3 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&i2c3m2_xfer>;
	// clock-frequency = <400000>;
	pc9202: pc9202@3c {
		status = "okay";
		compatible = "firefly,pc9202";
		reg = <0x3c>;
		wd-en-gpio = <&gpio1 RK_PC4 GPIO_ACTIVE_HIGH>;         // GPIO1_C4
		pinctrl-names = "default";
		pinctrl-0 = <&wdt_ctl1>;
		driver-names = "wdtdiban";
	};
};
#endif

# watchdog
CONFIG_PC9202_WATCHDOG=y

# expanders
CONFIG_GPIO_PCA953X=y
CONFIG_GPIO_PCA953X_IRQ=y
CONFIG_SPI_WK2XXX=y

# storage
CONFIG_SATA_AHCI_PLATFORM=y

# network
CONFIG_CAN=y
CONFIG_CAN_DEV=y
CONFIG_CANFD_ROCKCHIP=y
CONFIG_CAN_NETLINK=y
CONFIG_R8125=m
CONFIG_RTL8852BE=m
CONFIG_USB_USBNET=y
CONFIG_USB_NET_CDC_MBIM=y
CONFIG_USB_NET_QMI_WWAN=y
CONFIG_RTL8821CU=m
CONFIG_BT_HCIBTUSB=m
CONFIG_NET_VENDOR_MUCSE=y
CONFIG_MXGBE=m
CONFIG_MXGBEVF=m
CONFIG_IGB=m

# filesystem
CONFIG_OVERLAY_FS=y

# audio
CONFIG_SND_SOC_BT_SCO=m

# input/sensor
CONFIG_SENSORS_PWM_FAN=y
CONFIG_TOUCHSCREEN_HX83102=y
CONFIG_TOUCHSCREEN_GT9XXX=y
CONFIG_SENSOR_DEVICE=m
CONFIG_GSENSOR_DEVICE=m
CONFIG_GS_MC3230=m
CONFIG_DS18B20=y
CONFIG_GENERIC_ADC_THERMAL=y
CONFIG_PMBUS=y
CONFIG_SENSORS_PMBUS=y

# camera/cmos
CONFIG_VIDEO_XC7160=y
CONFIG_VIDEO_GC2053=y
CONFIG_VIDEO_GC2093=y
CONFIG_VIDEO_IMX586=y

# pci
CONFIG_PCI_IOV=y

# rtc
CONFIG_RTC_DRV_PCF8563=y

# others
CONFIG_LEDS_CLASS_FLASH=y
CONFIG_LEDS_RGB13H=y
CONFIG_GPIO_FIREFLY_GL3321G=y
CONFIG_UIO=m
CONFIG_GPIO_FIREFLY_DETECT_POSITION=y

# ntfs
CONFIG_NTFS_RW=y
CONFIG_NTFS3_FS=y
CONFIG_NTFS3_64BIT_CLUSTER=y
CONFIG_NTFS3_LZX_XPRESS=y
CONFIG_NTFS3_FS_POSIX_ACL=y

# exfat
CONFIG_EXFAT_FS=y
